# ./src/cli.sh
#!/bin/bash

BAREKUBE_RELEASE_URL="https://github.com/kostiantyn-matsebora/barekube/releases/latest/download"
# Releases are signed keylessly by the release workflow at a version tag.
BAREKUBE_SIGNER_IDENTITY='^https://github\.com/kostiantyn-matsebora/barekube/\.github/workflows/release\.yml@refs/tags/v[0-9]+\.[0-9]+\.[0-9]+$'
BAREKUBE_SIGNER_ISSUER="https://token.actions.githubusercontent.com"

# Prints the directory to install into: $HOME/bin when automatic, otherwise asked.
resolve_install_path() {
  local DEFAULT_PATH="$HOME/bin" CHOSEN_PATH
  if [[ "$(is_automatic_mode "$1")" == "0" ]]
  then
    echo "$DEFAULT_PATH"
    return 0
  fi
  CHOSEN_PATH="$(read_input "Enter the path where workspace is installed ($DEFAULT_PATH as default): ")"
  echo "${CHOSEN_PATH:-$DEFAULT_PATH}"
}

# Downloads the release script, its checksum and its signature bundle into DIR.
download_release() {
  local FILE
  for FILE in barekube SHA256SUMS barekube.sigstore.json
  do
    wget -q "$BAREKUBE_RELEASE_URL/$FILE" -O "$1/$FILE" || return 1
  done
}

verify_release_checksum() {
  echo_message "Verifying checksum..."
  (cd "$1" && sha256sum --check --status SHA256SUMS)
}

# Verifies the Sigstore signature, which proves the script was built by the
# release workflow of this repository. A checksum alone cannot: whoever can
# replace the script can replace the checksum next to it.
# Usage: verify_release_signature DIR [--skip-signature-check]
verify_release_signature() {
  if [[ "$2" == "--skip-signature-check" ]]
  then
    echo_info "Skipping signature verification; only the checksum was verified."
    return 0
  fi
  if ! check_if_command_exists cosign
  then
    echo_error "cosign is required to verify the release signature. Install it (https://docs.sigstore.dev/cosign/system_config/installation/) or pass --skip-signature-check."
    return 1
  fi
  echo_message "Verifying signature..."
  cosign verify-blob --bundle "$1/barekube.sigstore.json" \
    --certificate-identity-regexp "$BAREKUBE_SIGNER_IDENTITY" \
    --certificate-oidc-issuer "$BAREKUBE_SIGNER_ISSUER" "$1/barekube"
}

fetch_verified_release() {
  download_release "$1" || { echo_error "Failed to download the release"; return 1; }
  verify_release_checksum "$1" || { echo_error "Checksum verification failed"; return 1; }
  verify_release_signature "$1" "$2" || { echo_error "Signature verification failed"; return 1; }
}

# Installs the latest release only after it has been verified; the installed
# script is untouched when anything fails.
# Usage: upgrade_barekube [--yes|-y] [--skip-signature-check]
upgrade_barekube() {
  local BAREKUBE_PATH WORK_DIR STATUS
  echo_info "Upgrading barekube CLI $(barekube --version)"
  BAREKUBE_PATH="$(resolve_install_path "$1")"
  echo_message "Upgrading barekube CLI at $BAREKUBE_PATH"
  WORK_DIR="$(mktemp -d)" || { echo_error "Error upgrading barekube"; exit 1; }
  fetch_verified_release "$WORK_DIR" "$2" || { rm -rf "$WORK_DIR"; echo_error "Error upgrading barekube"; exit 1; }
  install -m 0755 "$WORK_DIR/barekube" "$BAREKUBE_PATH/barekube"
  STATUS=$?
  rm -rf "$WORK_DIR"
  if [[ "$STATUS" -ne 0 ]]
  then
    echo_error "Error upgrading barekube"
    exit "$STATUS"
  fi
  echo_info "Barekube CLI is upgraded successfully to version $(barekube --version)"
}

# ./src/gvisor.sh
#!/bin/bash

GVISOR_KEY_URL="https://gvisor.dev/archive.key"
GVISOR_KEYRING="/usr/share/keyrings/gvisor-archive-keyring.gpg"
GVISOR_REPO_URL="https://storage.googleapis.com/gvisor/releases"
GVISOR_APT_SOURCE="/etc/apt/sources.list.d/gvisor.list"
K3S_CONTAINERD_DIR="/var/lib/rancher/k3s/agent/etc/containerd"
# k3s applies every manifest in this directory on the server nodes, and removes
# nothing when a file is deleted. The files below belong to barekube.
K3S_MANIFESTS_DIR="/var/lib/rancher/k3s/server/manifests"
GVISOR_RUNTIMECLASSES_MANIFEST="$K3S_MANIFESTS_DIR/barekube-gvisor.yaml"
GVISOR_DEFAULT_MANIFEST="$K3S_MANIFESTS_DIR/barekube-gvisor-default.yaml"

install_gvisor_prerequisites() {
    run_privileged "Installing gVisor dependencies..." "Failed to install gVisor dependencies" \
        apt install -y apt-transport-https ca-certificates curl gnupg
}

add_gvisor_apt_key() {
    echo_message "Adding gVisor key..."
    curl -fsSL "$GVISOR_KEY_URL" | sudo gpg --dearmor --yes -o "$GVISOR_KEYRING"
    exit_if_error "Failed to add gVisor key"
}

add_gvisor_apt_repository() {
    echo_message "Adding gVisor repository..."
    echo "deb [arch=$(dpkg --print-architecture) signed-by=$GVISOR_KEYRING] $GVISOR_REPO_URL release main" \
        | sudo tee "$GVISOR_APT_SOURCE" > /dev/null
    exit_if_error "Failed to add gVisor repository"
}

install_gvisor_package() {
    echo_message "Installing gVisor..."
    sudo apt-get update && sudo apt-get install -y runsc
    exit_if_error "Failed to install gVisor"
}

install_gvisor() {
    install_gvisor_prerequisites
    add_gvisor_apt_key
    add_gvisor_apt_repository
    install_gvisor_package
}

# The runtime stanza for containerd 1.x (config version 2), which older k3s uses.
runsc_runtime_config_v2() {
    cat <<'EOF'
[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runsc]
  runtime_type = "io.containerd.runsc.v1"
EOF
}

# The same for containerd 2.x (config version 3), which current k3s uses. The
# CRI plugin has a different name there; the version 2 stanza is silently
# ignored by it, which leaves no runsc runtime registered.
runsc_runtime_config_v3() {
    cat <<'EOF'
[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runsc]
  runtime_type = 'io.containerd.runsc.v1'
EOF
}

# Adds the runsc runtime to one k3s containerd template. A new template extends
# the configuration k3s generates through its base template, so it keeps
# working as k3s changes its defaults; an existing template is only appended to.
# Returns 0 when it changed the template, 1 when runsc was already in it.
# Usage: add_runsc_to_template FILE STANZA_FUNCTION
add_runsc_to_template() {
    local FILE="$1" STANZA="$2"
    sudo grep -qs ".containerd.runtimes.runsc" "$FILE" && return 1
    if ! sudo test -f "$FILE"
    then
        echo '{{ template "base" . }}' | sudo tee "$FILE" > /dev/null
        exit_if_error "Failed to create the containerd template $FILE"
    fi
    echo_info "Adding runsc runtime to $FILE..."
    "$STANZA" | sudo tee -a "$FILE" > /dev/null
    exit_if_error "Failed to add runsc runtime to containerd configuration"
    return 0
}

# The RuntimeClasses pods use to pick a runtime: gvisor for the sandbox, runc
# to stay out of it.
gvisor_runtime_classes_manifest() {
    cat <<'EOF'
apiVersion: node.k8s.io/v1
kind: RuntimeClass
metadata:
  name: gvisor
handler: runsc
---
apiVersion: node.k8s.io/v1
kind: RuntimeClass
metadata:
  name: runc
handler: runc
EOF
}

# Sets runtimeClassName: gvisor on every new pod that names no RuntimeClass.
# Pods that need the host (host namespaces, privileged containers) and the
# system namespaces are left alone: gVisor cannot run them.
gvisor_default_policy_manifest() {
    cat <<'EOF'
apiVersion: admissionregistration.k8s.io/v1
kind: MutatingAdmissionPolicy
metadata:
  name: barekube-gvisor-default
spec:
  failurePolicy: Fail
  reinvocationPolicy: Never
  matchConstraints:
    resourceRules:
      - apiGroups: [""]
        apiVersions: ["v1"]
        operations: ["CREATE"]
        resources: ["pods"]
  matchConditions:
    - name: names-no-runtime-class
      expression: "!has(object.spec.runtimeClassName)"
    - name: does-not-use-host-namespaces
      expression: >-
        !(has(object.spec.hostNetwork) && object.spec.hostNetwork) &&
        !(has(object.spec.hostPID) && object.spec.hostPID) &&
        !(has(object.spec.hostIPC) && object.spec.hostIPC)
    - name: runs-no-privileged-container
      expression: >-
        !(object.spec.containers + (has(object.spec.initContainers) ? object.spec.initContainers : []))
        .exists(c, has(c.securityContext) && has(c.securityContext.privileged) && c.securityContext.privileged)
  mutations:
    - patchType: JSONPatch
      jsonPatch:
        expression: >-
          [JSONPatch{op: "add", path: "/spec/runtimeClassName", value: "gvisor"}]
---
apiVersion: admissionregistration.k8s.io/v1
kind: MutatingAdmissionPolicyBinding
metadata:
  name: barekube-gvisor-default
spec:
  policyName: barekube-gvisor-default
  matchResources:
    namespaceSelector:
      matchExpressions:
        - key: kubernetes.io/metadata.name
          operator: NotIn
          values: [kube-system, kube-public, kube-node-lease, longhorn-system]
EOF
}

# Writes a manifest for k3s to apply.
# Returns 0 when it wrote the file, 1 when the file was already as it should be.
# Usage: write_k3s_manifest FILE CONTENT_FUNCTION
write_k3s_manifest() {
    local FILE="$1" CONTENT="$2"
    "$CONTENT" | sudo cmp -s - "$FILE" && return 1
    run_privileged "Preparing $K3S_MANIFESTS_DIR..." "Failed to create $K3S_MANIFESTS_DIR" \
        mkdir -p "$K3S_MANIFESTS_DIR"
    echo_info "Writing $FILE..."
    "$CONTENT" | sudo tee "$FILE" > /dev/null
    exit_if_error "Failed to write $FILE"
    return 0
}

# Returns 0 when it removed the manifest, 1 when there was none.
# Usage: remove_k3s_manifest FILE
remove_k3s_manifest() {
    sudo test -f "$1" || return 1
    echo_info "Removing $1..."
    sudo rm -f "$1"
    exit_if_error "Failed to remove $1"
    return 0
}

# Registers the runsc runtime with containerd on this node; k3s restarts once
# if anything changed.
register_gvisor_to_k3s() {
    local SERVICE CHANGED=1
    SERVICE="$(k3s_service_name)"
    echo_message "Checking containerd configuration..."
    run_privileged "Preparing the containerd template directory..." "Failed to create $K3S_CONTAINERD_DIR" \
        mkdir -p "$K3S_CONTAINERD_DIR"

    add_runsc_to_template "$K3S_CONTAINERD_DIR/config.toml.tmpl" runsc_runtime_config_v2 && CHANGED=0
    add_runsc_to_template "$K3S_CONTAINERD_DIR/config-v3.toml.tmpl" runsc_runtime_config_v3 && CHANGED=0
    if [[ "$CHANGED" -ne 0 ]]
    then
        echo_message "The runsc runtime is already registered."
        return 0
    fi

    run_privileged "Restarting $SERVICE..." "Failed to register gVisor to k3s" systemctl restart "$SERVICE"
}

# Makes the gvisor and runc RuntimeClasses available in the cluster and, when
# asked, makes gVisor the default for pods that name no RuntimeClass. These are
# cluster objects, applied by a server node; agents have nothing to do here.
# Usage: publish_gvisor_to_cluster [on|off]   (empty leaves the default as it is)
publish_gvisor_to_cluster() {
    if [[ "$(k3s_service_name)" != "k3s" ]]
    then
        if [[ -n "$1" ]]
        then
            echo_error "The gVisor default is a cluster setting: run this on a control-plane node, not an agent."
            return 1
        fi
        return 0
    fi
    write_k3s_manifest "$GVISOR_RUNTIMECLASSES_MANIFEST" gvisor_runtime_classes_manifest
    case "$1" in
        on) write_k3s_manifest "$GVISOR_DEFAULT_MANIFEST" gvisor_default_policy_manifest ;;
        off)
            # k3s does not delete what a removed manifest created.
            remove_k3s_manifest "$GVISOR_DEFAULT_MANIFEST"
            run_privileged "Removing the gVisor default policy from the cluster..." \
                "Failed to remove the gVisor default policy" \
                k3s kubectl delete mutatingadmissionpolicybinding,mutatingadmissionpolicy \
                barekube-gvisor-default --ignore-not-found
            ;;
    esac
    return 0
}

# Installs gVisor and wires it into k3s and the cluster - what every node install needs.
# Usage: setup_gvisor [on|off]
setup_gvisor() {
    install_gvisor
    register_gvisor_to_k3s
    publish_gvisor_to_cluster "$1" || exit 1
}

# ./src/k3s.sh
#!/bin/bash

K3S_INSTALL_URL="https://get.k3s.io"
K3S_FLANNEL_BACKEND="wireguard-native"
K3S_SYSTEMD_DIR="/etc/systemd/system"

# The service running k3s on this node: agents run k3s-agent, servers run k3s.
k3s_service_name() {
    if [[ -f "$K3S_SYSTEMD_DIR/k3s-agent.service" ]]
    then
        echo "k3s-agent"
    else
        echo "k3s"
    fi
}

# Set by the install commands from the repeatable --tls-san and --disable flags.
TLS_SANS=()
DISABLE_COMPONENTS=()

check_k3s_installed() {
    echo_message "Checking if k3s is already installed..."
    if check_if_command_exists "k3s"
    then
        echo_info "k3s is already installed."
        report_state "already installed"
        if [[ "$1" -ne "1" ]]
        then
            exit 0
        fi
    fi
}

# Builds the extra k3s server arguments. Values given as flags are used as is
# and never prompted for; with --yes and no flags nothing is asked or added;
# otherwise the user is asked interactively.
# Usage: gather_additional_args [--yes] [EXTRA_ARGS]
gather_additional_args() {
    local YES="$1" EXTRA="$2" ADDITIONAL_ARGS="" ITEM
    if ((${#DISABLE_COMPONENTS[@]} + ${#TLS_SANS[@]})) || [[ -n "$EXTRA" ]]
    then
        for ITEM in "${DISABLE_COMPONENTS[@]}"
        do
            ADDITIONAL_ARGS="$ADDITIONAL_ARGS --disable=$ITEM"
        done
        for ITEM in "${TLS_SANS[@]}"
        do
            ADDITIONAL_ARGS="$ADDITIONAL_ARGS --tls-san $ITEM"
        done
        if [[ -n "$EXTRA" ]]
        then
            ADDITIONAL_ARGS="$ADDITIONAL_ARGS $EXTRA"
        fi
        echo "$ADDITIONAL_ARGS"
        return 0
    fi
    [[ "$(is_automatic_mode "$YES")" == "0" ]] && return 0

    yes_or_no "Do you want to set additional parameters?" || return 0
    if yes_or_no "Do you want to disable load balancer"
    then
        ADDITIONAL_ARGS="$ADDITIONAL_ARGS --disable=servicelb"
    fi
    if yes_or_no "Do you want to disable traefik"
    then
        ADDITIONAL_ARGS="$ADDITIONAL_ARGS --disable=traefik"
    fi
    if yes_or_no "Do you want to set TLS SAN?"
    then
        ADDITIONAL_ARGS="$ADDITIONAL_ARGS --tls-san $(read_input "Enter the SAN:")"
    fi
    if yes_or_no "Do you want to add another additional arguments?"
    then
        ADDITIONAL_ARGS="$ADDITIONAL_ARGS $(read_input "Enter the additional arguments:")"
    fi
    echo "$ADDITIONAL_ARGS"
}

# Prints the cluster URL to join: the flag value, else a prompt (never with --yes).
# Usage: resolve_server_url SERVER [--yes]
resolve_server_url() {
    if [[ -n "$1" ]]
    then
        echo "$1"
        return 0
    fi
    if [[ "$(is_automatic_mode "$2")" == "0" ]]
    then
        echo_error "--server is required with --yes." >&2
        return 1
    fi
    read_required_input "Enter the master URL(e.g. https://192.168.1.1:6443):" "Master URL is required."
}

# Prints the join token: the K3S_TOKEN environment variable, else a prompt
# (never with --yes). There is deliberately no --token flag: it would show in
# ps and shell history.
# Usage: resolve_token [--yes]
resolve_token() {
    if [[ -n "${K3S_TOKEN:-}" ]]
    then
        echo "$K3S_TOKEN"
        return 0
    fi
    if [[ "$(is_automatic_mode "$1")" == "0" ]]
    then
        echo_error "K3S_TOKEN is required with --yes." >&2
        return 1
    fi
    read_required_input "Enter the token:" "Token is required."
}

# Pipes the official k3s installer into sh. The arguments are split on
# whitespace only - never evaluated - so input cannot inject shell syntax.
# The join token is not an argument: the installer reads K3S_TOKEN from the
# environment, which keeps it out of ps and the logged command line.
run_k3s_installer() {
    local -a INSTALLER_ARGS
    read -ra INSTALLER_ARGS <<<"$*"
    echo_message "Running command: curl -sfL $K3S_INSTALL_URL | sh -s - ${INSTALLER_ARGS[*]}"
    curl -sfL "$K3S_INSTALL_URL" | sh -s - "${INSTALLER_ARGS[@]}"
    exit_if_error "Failed to install k3s"
    return 0
}

install_k3s_initial_master() {
    echo_message "Installing initial k3s master node..."
    run_k3s_installer server --cluster-init --flannel-backend "$K3S_FLANNEL_BACKEND" "$1"
}

show_k3s_token() {
    echo_message "Getting token..."
    local K3S_TOKEN
    K3S_TOKEN=$(sudo cat /var/lib/rancher/k3s/server/token)
    echo_message "K3S_TOKEN: $(magenta """$K3S_TOKEN""")"
    echo_message "Use it for joining agents and other master nodes to the cluster."
}

# Usage: install_k3s_master SERVER_URL [ADDITIONAL_ARGS]; K3S_TOKEN exported.
install_k3s_master() {
    echo_message "Installing k3s master node..."
    run_k3s_installer server --server "$1" --flannel-backend "$K3S_FLANNEL_BACKEND" "$2"
}

# Usage: install_k3s_agent SERVER_URL; K3S_TOKEN exported.
install_k3s_agent() {
    echo_message "Installing k3s agent node..."
    K3S_URL="$1" run_k3s_installer agent
}

start_k3s_master() {
    run_privileged "Starting k3s..." "Failed to start k3s" systemctl start k3s
}

stop_k3s_master() {
    run_privileged "Stopping k3s..." "Failed to stop k3s" systemctl stop k3s
}

start_k3s_agent() {
    run_privileged "Starting k3s agent..." "Failed to start k3s agent" systemctl start k3s-agent
}

stop_k3s_agent() {
    run_privileged "Stopping k3s agent..." "Failed to stop k3s agent" systemctl stop k3s-agent
}

killall_k3s() {
    run_privileged "Killing k3s..." "Failed to kill k3s" /usr/local/bin/k3s-killall.sh
}

# Agents have their own uninstall script; servers have k3s-uninstall.sh.
# Usage: uninstall_k3s [--yes]
uninstall_k3s() {
    local SCRIPT="/usr/local/bin/k3s-uninstall.sh"
    if [[ "$(k3s_service_name)" == "k3s-agent" ]]
    then
        SCRIPT="/usr/local/bin/k3s-agent-uninstall.sh"
    fi
    if yes_or_no "Do you want to uninstall k3s?" "$(is_automatic_mode "$1")"
    then
        run_privileged "Uninstalling k3s..." "Failed to uninstall k3s" "$SCRIPT"
    fi
}

